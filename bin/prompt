#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: $(basename "$0") <title> <multiline-string>"
  echo
  echo "Provide a title (used for zenity) and the options as a single, quoted argument where each line is an option."
  echo
  echo "Example:"
  echo "  $(basename "$0") "Select an option" $'option1\noption2\noption3'"
  exit 2
} 

if [ "$#" -ne 2 ]; then
  usage
fi

title="$1"
input="$2"

# Split input into lines preserving empty lines
options=()
while IFS= read -r line; do
  options+=("$line")
done <<<"$input"

if [ "${#options[@]}" -eq 0 ]; then
  echo "Error: no options provided" >&2
  exit 1
fi

# If there is only one option, print it immediately (no user interaction)
if [ "${#options[@]}" -eq 1 ]; then
  printf '%s\n' "${options[0]}"
  exit 0
fi

ui_mode_config="$(get-config bash-functions.ui-mode "")"

if [ "$ui_mode_config" = "terminal" ]; then
  ui_mode="terminal"
elif [ "$ui_mode_config" = "zenity" ]; then
  ui_mode="zenity"
elif ! command -v zenity >/dev/null 2>&1; then
  ui_mode="terminal"
elif [ -t 1 ] || [ -n "${PS1:-}" ]; then
  ui_mode="terminal"
else
  ui_mode="zenity"
fi

if [ "$ui_mode" = "terminal" ]; then

  PS3="$title: "
  select opt in "${options[@]}"; do
    if [ -n "${opt:-}" ]; then
      printf '%s\n' "$opt"
      exit 0
    else
      echo "Invalid selection." >&2
    fi
  done
else
  selected="$(zenity --list --title="$title" --column="Option" "${options[@]}")"
  rc=$?
  if [ "$rc" -ne 0 ]; then
    # User cancelled or an error occurred
    exit 1
  fi
  printf '%s\n' "$selected"
  exit 0
fi
