#!/bin/bash

# get-credential <key> [--1p] [--1p-label LABEL]
#
# Retrieves and echoes a secret.
# By default, prompts the user using the read command.
#
# Options:
#   --1p              Retrieve the credential from 1Password instead of prompting
#   --1p-label LABEL  Specify the field label to retrieve from 1Password (default: password)
#
# Examples:
#   get-credential mykey
#   get-credential mykey --1p
#   get-credential mykey --1p --1p-label username

set -euo pipefail

# Validate at least one argument (the key)
if [[ $# -lt 1 ]]; then
    echo "Usage: get-credential <key> [--1p] [--1p-label LABEL]" >&2
    exit 1
fi

key="$1"
use_1p=false
label="password"

# Parse optional parameters
shift || true
while [[ $# -gt 0 ]]; do
    case "$1" in
        --1p)
            use_1p=true
            shift
            ;;
        --1p-label)
            if [[ $# -lt 2 ]]; then
                echo "Error: --1p-label requires a label argument" >&2
                exit 1
            fi
            label="$2"
            shift 2
            ;;
        *)
            echo "Error: Unknown option '$1'" >&2
            exit 1
            ;;
    esac
done

if $use_1p; then
    # Retrieve from 1Password using the op CLI
    # Requires 1Password CLI to be installed and authenticated
    op item get "$key" --fields "label=$label" --format json | jq -r '.value'
else
    # Prompt user for input (input is hidden with -s flag)
    read -rs -p "Enter credential for '$key': " credential
    echo "$credential"
fi
