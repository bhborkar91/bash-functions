#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<EOF >&2
Usage: $(basename "$0") <subcommand> [args]

Subcommands:
  in    Print incoming commits (present in upstream but not in HEAD).
    By default, merge commits are excluded.
    Pass --include-merges to include merge commits.
  out   Print outgoing commits (present in HEAD but not in upstream).
    By default, merge commits are excluded.
    Pass --include-merges to include merge commits.
  hist  Print git history using the same formatted output as git-ops.
  top [n]
    Print the last n commits using the same formatted output as git-ops.
    Defaults to 1 if n is omitted.
  branch-push <branch>
    Save current location (branch/tag/commit) and checkout <branch>.
    No-op if workspace is dirty or checkout fails.
  branch-pop
    Checkout the latest saved location and remove it from saved stack.
    No-op if workspace is dirty.

Output format:
  [date] [commit id] message [committer] (branch and tag info)
EOF
  exit 2
}

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

set_config_cmd="$script_dir/set-config"
get_config_cmd="$script_dir/get-config"

ensure_git_repo() {
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    echo "Error: not inside a git repository" >&2
    exit 1
  fi
}

ensure_clean_workspace() {
  if [ -n "$(git status --porcelain --untracked-files=normal)" ]; then
    echo "Error: workspace is dirty; commit/stash changes before switching branches" >&2
    exit 1
  fi
}

get_repo_stack_key() {
  local repo_root

  repo_root="$(git rev-parse --show-toplevel)"
  printf 'git-ops.branch-stack::%s\n' "$repo_root"
}

get_current_location_token() {
  local branch_name
  local tag_name
  local commit_sha

  branch_name="$(git symbolic-ref --quiet --short HEAD 2>/dev/null || true)"
  if [ -n "$branch_name" ]; then
    printf 'branch::%s\n' "$branch_name"
    return 0
  fi

  tag_name="$(git describe --tags --exact-match 2>/dev/null || true)"
  if [ -n "$tag_name" ]; then
    printf 'tag::%s\n' "$tag_name"
    return 0
  fi

  commit_sha="$(git rev-parse HEAD)"
  printf 'commit::%s\n' "$commit_sha"
}

resolve_checkout_ref_from_token() {
  local token="$1"

  case "$token" in
    branch::*)
      printf '%s\n' "${token#branch::}"
      ;;
    tag::*)
      printf 'refs/tags/%s\n' "${token#tag::}"
      ;;
    commit::*)
      printf '%s\n' "${token#commit::}"
      ;;
    *)
      # Backward compatibility for untyped saved entries.
      printf '%s\n' "$token"
      ;;
  esac
}

append_stack_entry() {
  local stack_key="$1"
  local entry="$2"
  local current_stack
  local updated_stack

  current_stack="$($get_config_cmd "$stack_key" "")"
  if [ -n "$current_stack" ]; then
    updated_stack="$current_stack"$'\n'"$entry"
  else
    updated_stack="$entry"
  fi

  "$set_config_cmd" "$stack_key" "$updated_stack" >/dev/null
}

pop_stack_entry() {
  local stack="$1"
  local top_entry
  local remaining_stack

  top_entry="${stack##*$'\n'}"

  if [[ "$stack" == *$'\n'* ]]; then
    remaining_stack="${stack%$'\n'*}"
  else
    remaining_stack=""
  fi

  printf '%s\n' "$top_entry"
  printf '%s\n' "$remaining_stack"
}

get_upstream_ref() {
  if ! git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null; then
    current_branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo unknown)"
    echo "Error: no upstream configured for branch '$current_branch'" >&2
    echo "Hint: set one with: git branch --set-upstream-to origin/$current_branch" >&2
    exit 1
  fi
}

print_commit_log() {
  local rev_range="$1"
  local include_merges="$2"

  if [ "$include_merges" = "true" ]; then
    git --no-pager log --color=always "$rev_range" \
      --date=short \
      --pretty=format:'%C(yellow)[%ad]%C(reset) %C(cyan)[%h]%C(reset) %s %C(green)[%cn]%C(reset) %C(magenta)(%D)%C(reset)'
  else
    git --no-pager log --color=always "$rev_range" \
      --no-merges \
      --date=short \
      --pretty=format:'%C(yellow)[%ad]%C(reset) %C(cyan)[%h]%C(reset) %s %C(green)[%cn]%C(reset) %C(magenta)(%D)%C(reset)'
  fi

  # Keep output newline-terminated for predictable terminal rendering.
  echo
}

print_history_log() {
  local max_count="$1"
  shift

  local git_args=("$@")

  if [ -n "$max_count" ]; then
    git --no-pager log --color=always \
      --date=short \
      --pretty=format:'%C(yellow)[%ad]%C(reset) %C(cyan)[%h]%C(reset) %s %C(green)[%cn]%C(reset) %C(magenta)(%D)%C(reset)' \
      --max-count="$max_count" \
      "${git_args[@]}"
  else
    git --no-pager log --color=always \
      --date=short \
      --pretty=format:'%C(yellow)[%ad]%C(reset) %C(cyan)[%h]%C(reset) %s %C(green)[%cn]%C(reset) %C(magenta)(%D)%C(reset)' \
      "${git_args[@]}"
  fi

  # Keep output newline-terminated for predictable terminal rendering.
  echo
}

parse_include_merges_flag() {
  if [ "$#" -eq 0 ]; then
    echo "false"
    return 0
  fi

  if [ "$#" -eq 1 ] && [ "$1" = "--include-merges" ]; then
    echo "true"
    return 0
  fi

  usage
}

cmd_in() {
  local upstream_ref
  local include_merges

  include_merges="$(parse_include_merges_flag "$@")"

  ensure_git_repo
  upstream_ref="$(get_upstream_ref)"

  # Show commits present in upstream but not in HEAD (incoming commits).
  print_commit_log "HEAD..$upstream_ref" "$include_merges"
}

cmd_out() {
  local upstream_ref
  local include_merges

  include_merges="$(parse_include_merges_flag "$@")"

  ensure_git_repo
  upstream_ref="$(get_upstream_ref)"

  # Show commits present in HEAD but not in upstream (outgoing commits).
  print_commit_log "$upstream_ref..HEAD" "$include_merges"
}

cmd_hist() {
  ensure_git_repo

  print_history_log "" "$@"
}

validate_positive_integer() {
  local value="$1"

  if [[ "$value" =~ ^[1-9][0-9]*$ ]]; then
    return 0
  fi

  return 1
}

cmd_top() {
  local max_count

  if [ "$#" -gt 1 ]; then
    usage
  fi

  max_count="${1:-1}"

  if ! validate_positive_integer "$max_count"; then
    echo "Error: top expects a positive integer count" >&2
    exit 2
  fi

  ensure_git_repo

  print_history_log "$max_count"
}

cmd_branch_push() {
  local target_branch
  local stack_key
  local current_location

  if [ "$#" -ne 1 ]; then
    usage
  fi

  target_branch="$1"

  ensure_git_repo
  ensure_clean_workspace

  stack_key="$(get_repo_stack_key)"
  current_location="$(get_current_location_token)"

  if ! git checkout "$target_branch"; then
    echo "Error: failed to checkout '$target_branch'; not updating saved stack" >&2
    exit 1
  fi

  append_stack_entry "$stack_key" "$current_location"
}

cmd_branch_pop() {
  local stack_key
  local current_stack
  local popped
  local top_token
  local remaining_stack
  local checkout_ref

  if [ "$#" -ne 0 ]; then
    usage
  fi

  ensure_git_repo
  ensure_clean_workspace

  stack_key="$(get_repo_stack_key)"
  current_stack="$($get_config_cmd "$stack_key" "")"

  if [ -z "$current_stack" ]; then
    echo "No saved branch stack for this repository"
    return 0
  fi

  popped="$(pop_stack_entry "$current_stack")"
  top_token="$(printf '%s\n' "$popped" | sed -n '1p')"
  remaining_stack="$(printf '%s\n' "$popped" | sed -n '2,$p')"
  checkout_ref="$(resolve_checkout_ref_from_token "$top_token")"

  if ! git checkout "$checkout_ref"; then
    echo "Error: failed to checkout saved location '$checkout_ref'; saved stack unchanged" >&2
    exit 1
  fi

  "$set_config_cmd" "$stack_key" "$remaining_stack" >/dev/null
}

main() {
  local subcommand

  if [ "$#" -lt 1 ]; then
    usage
  fi

  subcommand="$1"
  shift

  case "$subcommand" in
    in)
      cmd_in "$@"
      ;;
    out)
      cmd_out "$@"
      ;;
    hist)
      cmd_hist "$@"
      ;;
    top)
      cmd_top "$@"
      ;;
    branch-push)
      cmd_branch_push "$@"
      ;;
    branch-pop)
      cmd_branch_pop "$@"
      ;;
    *)
      usage
      ;;
  esac
}

main "$@"
