#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<EOF >&2
Usage: $(basename "$0") <question>

Asks the user a yes/no confirmation question.

If called from a terminal, prompts in the terminal with [y/N].
If not called from a terminal, uses zenity to show a confirmation dialog.

Outputs:
  "y" if the user confirms
  "n" if the user declines or cancels

Exit codes:
  0 - Always (even if user declined)
EOF
  exit 2
}

if [ "$#" -ne 1 ]; then
  usage
fi

question="$1"

ui_mode_config="$(get-config bash-functions.ui-mode "")"

if [ "$ui_mode_config" = "terminal" ]; then
  ui_mode="terminal"
elif [ "$ui_mode_config" = "zenity" ]; then
  ui_mode="zenity"
elif ! command -v zenity >/dev/null 2>&1; then
  ui_mode="terminal"
elif [ -t 1 ] || [ -n "${PS1:-}" ]; then
  ui_mode="terminal"
else
  ui_mode="zenity"
fi

if [ "$ui_mode" = "terminal" ]; then
  echo "$question [y/N]: " >&2
  read -r answer
  case "${answer,,}" in
    y|yes) echo "y" ;;
    *) echo "n" ;;
  esac
else
  if zenity --question --title="Confirmation" --text="$question" 2>/dev/null; then
    echo "y"
  else
    echo "n"
  fi
fi
