#!/usr/bin/env bash
set -euo pipefail

log_msg() {
  printf '%s [offline-ns] %s\n' "$(date '+%H:%M:%S')" "$1" >&2
}

log_info() {
  log_msg "INFO: $1"
}

log_warn() {
  log_msg "WARN: $1"
}

log_error() {
  log_msg "ERROR: $1"
}

usage() {
  cat >&2 <<'EOF'
Usage: offline-ns [-u user] [--no-info] [--] <command> [args...]

Runs the given command in a Linux network namespace named "offline".
The namespace is created on first use if needed, then loopback is brought up, and the command runs in the namespace as the requested user.
If not called from a terminal, it tries a graphical privilege prompt before falling back to sudo.

Options:
  -u USER     Run the command as USER inside the namespace. Defaults to the original invoking user.
  --no-info   Skip the sudoers NOPASSWD guidance.
  -h, --help  Show this help.
EOF
  exit 2
}

show_sudoers_info() {
  local user_name script_path
  user_name="${1:-${SUDO_USER:-${USER:-$(id -un 2>/dev/null || echo root)}}}"
  script_path="${0}"

  log_info "Displaying sudoers guidance for user '${user_name}'."

  cat >&2 <<EOF
Info: to avoid password prompts when escalating to root, add this to /etc/sudoers.d/offline-ns:

  ${user_name} ALL=(root) NOPASSWD: ${script_path} -u ${user_name} -- *

This allows the non-root user to run:

  sudo ${script_path} -u ${user_name} -- <command>

After that, the script creates the namespace and runs the target command inside it as the requested user. No extra sudoers rule is needed for the namespace setup itself because it runs as root after the initial escalation.

Then validate it with:

  sudo visudo -f /etc/sudoers.d/offline-ns

EOF
}

show_error_notification() {
  local message="$1"
  log_error "$message"
  echo "$message" >&2
}

fail_with_error() {
  local message="$1"
  show_error_notification "$message"
  exit 1
}

namespace_exists() {
  ip netns list 2>/dev/null | awk '{print $1}' | grep -Fxq "offline"
}

ensure_offline_namespace() {
  if ! namespace_exists; then
    log_info "Namespace 'offline' does not exist; creating it."
    ip netns add offline
  else
    log_info "Namespace 'offline' already exists."
  fi

  if ! ip netns exec offline ip link show lo 2>/dev/null | grep -Eq 'state (UP|UNKNOWN)'; then
    log_info "Bringing loopback up inside namespace 'offline'."
    ip netns exec offline ip link set lo up
  else
    log_info "Loopback interface is already up inside namespace 'offline'."
  fi
}

trigger_root_exec() {
  local user_name="$1"
  shift

  if [ -t 0 ] && [ -t 1 ]; then
    log_info "Escalating to root via sudo for user '${user_name}'."
    exec sudo -- "$0" -u "$user_name" -- "$@"
  fi

  log_info "No terminal detected; falling back to sudo for user '${user_name}'."
  exec sudo -- "$0" -u "$user_name" -- "$@"
}

main() {
  local show_info=1
  local user_name=""

  while [ "$#" -gt 0 ]; do
    case "$1" in
      -u)
        if [ "$#" -lt 2 ]; then
          usage
        fi
        user_name="$2"
        shift 2
        ;;
      --no-info)
        show_info=0
        shift
        ;;
      --help|-h)
        usage
        ;;
      --)
        shift
        break
        ;;
      *)
        break
        ;;
    esac
  done

  if [ "$#" -eq 0 ]; then
    usage
  fi

  if [ -z "$user_name" ]; then
    user_name="${SUDO_USER:-${USER:-$(id -un 2>/dev/null || echo root)}}"
  fi

  log_info "Starting offline-ns for user '${user_name}' with command: $*"

  if [ "$show_info" -eq 1 ]; then
    show_sudoers_info "$user_name"
  fi

  if [ "$(id -u)" -eq 0 ]; then
    log_info "Already running as root; preparing namespace and executing command in it."
    ensure_offline_namespace
    log_info "Executing command inside namespace as user '${user_name}'."
    exec ip netns exec offline sudo -u "$user_name" -- "$@"
  fi

  trigger_root_exec "$user_name" "$@"
}

main "$@"
